{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=WorkOrderTranscription;Trusted_Connection=True;MultipleActiveResultSets=true"
  },

  "Transcription": {
    "EnableLlmFallback": true,
    "LlmThreshold": 0.8,
    "MinConfidenceToApply": 0.6
  },

  "BlobStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "wo-audio"
  },

  "AzureSpeech": {
    "SubscriptionKey": "YOUR_AZURE_SPEECH_KEY",
    "Region": "westeurope",
    "Endpoint": "https://westeurope.api.cognitive.microsoft.com"
  },

  "AzureOpenAI": {
    "Endpoint": "https://YOUR_RESOURCE.openai.azure.com/",
    "DeploymentName": "gpt-4o-mini",
    "ApiKey": "YOUR_AZURE_OPENAI_KEY",
    "MaxTokens": 150,
    "Temperature": 0.0,
    "TimeoutSeconds": 10
  },

  "ApplicationInsights": {
    "ConnectionString": "YOUR_APP_INSIGHTS_CONNECTION_STRING"
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  }
}
